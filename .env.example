# code-report-back — environment (TASK-001 §2, §8)
#
# Copy to .env and fill in. NEVER commit a real .env: it carries the session
# secret and the database password.

# --- Required: the process exits non-zero at startup if either is missing ---

# PostgreSQL connection string.
DATABASE_URL=postgres://code_report:change-me@localhost:5432/code_report

# Secret used to sign the session cookie (TASK-002). Use a long random value.
# Its value is never logged.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional: the value shown is the built-in default ---

# HTTP port.
PORT=8080

# Timezone the chosen report day / date range is counted in
# (REQ-001 §4.5 — Asia/Bangkok is the confirmed requirement).
REPORT_TIMEZONE=Asia/Bangkok

# AI API CENTER base URL.
#   local:      http://localhost:3009
#   production: https://ai.develyst.online
AI_API_CENTER_URL=http://localhost:3009

# Optional bearer token for AI API CENTER. Unset by default — the service has
# no authentication today; this exists so that adding auth is a config change
# and not a code change (SPEC-001). Its value is never logged.
# AI_API_CENTER_TOKEN=

# Allow git remotes whose host resolves to a loopback/link-local/private range
# (e.g. a self-hosted GitLab on the LAN). Off by default (SPEC-001).
ALLOW_PRIVATE_GIT_HOSTS=false

# Maximum report jobs running at the same time, process-wide (SPEC-001).
MAX_CONCURRENT_JOBS=2

# Path to the JSON file `bun run seed:users` reads at installation time:
#   [{ "username": "...", "displayName": "...", "password": "..." }]
# This file holds plaintext passwords — keep it out of the repo and delete it
# once the accounts exist.
# SEED_USERS_FILE=./seed-users.json
